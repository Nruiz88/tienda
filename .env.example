# =========================================================
# Microservicio — configuración
# ---------------------------------------------------------
# Copia a .env.local y rellena. Lo que no se pone, sale con su valor de
# desarrollo y el servicio funciona con datos de mentira, que es peor
# que no funcionar.
#
# ⚠️  AQUÍ NO VAN CLAVES DE VERDAD
# Este fichero va al repositorio. Un .example con la clave real escrita
# es una bomba de relojería: el día que alguien lo sube, la clave está
# en git para siempre.
# =========================================================


# ---- Supabase ----

# La MISMA base que el panel. No son dos bases: este servicio no tiene
# usuarios propios, usa la identidad de Supabase Auth del panel, y las
# políticas RLS de la misma tabla.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Del SERVIDOR. Salta RLS.
#
# Empieza por sb_secret_. Si empieza por sb_publishable_, has puesto la
# del cliente: la app funciona en local (donde el error es el mismo) y en
# producción se rompe de formas distintas según qué ruta se ejecutó.
SUPABASE_SECRET_KEY=

# Para el cliente de Supabase con el token del usuario. Aplica RLS.
# Empieza por sb_publishable_ y es más corta.
SUPABASE_PUBLISHABLE_KEY=


# ---- Ticket firmado ----

# COMPARTIDA con el panel, carácter por carácter. El panel firma el
# ticket en #ticket= y este servicio lo verifica aquí. Si difieren, el
# canje responde 401 y no dice por qué.
#
# Lo que NO puede compartirse es SESSION_SECRET: cada servicio firma su
# cookie con la suya, y si compartieran, una cookie válida en el panel
# valdría en este servicio. Eso es justo lo que el host-only evita.
#
# Para diagnosticar un 401: compara las LONGITUDES de los dos secretos
# primero. Si no coinciden, ya sabes lo que es.
SERVICE_SECRET=


# ---- Otros ----

# Zona horaria del negocio. Manda en "hoy", "mañana" y en los
# recordatorios. Sin esto usa America/Argentina/Buenos_Aires.
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# URL pública de este servicio, para los enlaces que genera él mismo.
APP_URL=https://TU-SERVICIO.midominio.com

# URL pública del panel (Nexo Studio). La usa `src/lib/panel.ts` para
# "volver al panel" desde /entrar y /sin-acceso.
NEXT_PUBLIC_PANEL_URL=https://TU-PANEL.midominio.com


# ---- Modo diseño (TEMPORAL) ----

# Interruptor para ver y retocar el shop SIN ticket, sin sesión y sin
# base: las pantallas usan datos de demo. Ver `src/lib/modo.ts`.
#
#   (sin poner)  encendido SOLO en desarrollo
#   1            encendido aunque sea producción   ← NO en producción real
#   0            apagado: exige el ticket de verdad
#
# Para probar el flujo real del ticket:
#   NEXT_PUBLIC_MODO_DISENO=0
NEXT_PUBLIC_MODO_DISENO=1


# Para conectar a la base a mano: migraciones, scripts. NO la usa la
# aplicación.
#
# ⚠️  Esta URL tiene una contraseña dentro, y termina en la consola y
# en el historial de la shell. Por eso es una variable aparte y no una
# que componga SUPABASE_URL.
DATABASE_URL=postgresql://postgres.TU_PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Correo (opcional) ----
# Si no está, no se mandan los correos del pedido (y no pasa nada: el
# pedido queda igual). Se usan para confirmar al comprador y avisar al
# dueño.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=


NODE_ENV=development
PORT=3000